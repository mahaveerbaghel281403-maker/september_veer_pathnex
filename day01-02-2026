### ANSIBLE - install nginx

---
- name: Install nginx on veer server
  hosts: all
  become: yes

  tasks:
    - name: install nginx
      yum:
        name: nginx
	state: present


### TERRAFORM - CREATE EC2 

provider "aws" {
  region = "ap-south-1"
}

resource "aws_instance" "veer_server" {
  ami = "ami-2124qfufg"
  instance_type = "c5.xlarge"

  tags {
    Name = "veerserver"

  }
}

### kubernetes - create nginx pod
apiVersion: v1
kind: Pod
metadata:
  namespace: dev

spec: 
  containers:
    - name: web
      image: nginx:latest
      ports:
        - containerPort: 80
