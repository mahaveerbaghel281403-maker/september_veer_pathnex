### ansible 

---
- name: manage nginx
  hosts: all
  become: yes

  tasks:
    - name: Update config file
      copy:
        src: index.html
	dest: /usr/share/nginx/html/index.html
      notify: Restart nginx

  handlers:
    - name: restart nginx
      service:
        name: nginx
	state: restarted

