	shell: /bin/bash


### terraform

provider "aws" {
  region = "ap-south-1"
}

resource "aws_security_group" "veersg" {
  name = "veersg"
  description = "veer sg for ssh"

  ingress {
    from_port = 22
    to_port = 22
    protocol = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

resource "aws_instance" "veer-server" {
  ami = "ami-1234jkdhffo"
  instance_type = "r6.4xlarge"
  vpc_security_group_ids = [aws_security_group.veersg.id]

  tags = {
    name = "veer-server"
  }
}

