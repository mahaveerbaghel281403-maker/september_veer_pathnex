### kubernetes

apiVersion: apps/v1
kind: Deployment
metadata:
  name: nginx-deployment
spec:
  replicas:
  selector:
    matchLables:
      app: veer-app
  template:
    metadata:
      lables:
        app: veer-app

    spec:
      containers:
        - name; app
	  image; nginx
	  ports:
	    - containerPort: 80

