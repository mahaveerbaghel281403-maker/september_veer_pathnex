### ansible
---
-  name: install & enable nginx
   hosts: all
   become: yes

   tasks:
     - name: install nginx
       yum:
         name: nginx
	 state: present
     
     - name: enable nginx
       service: 
         name: nginx
	 state: started
	 enabled: yes


